<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>
        
        <rewrite>
            <rules>
                <rule name="StaticFiles" stopProcessing="true">
                    <match url="^static/.*" />
                    <action type="None" />
                </rule>
                <rule name="VanillaJs_Backend" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://localhost:8007/{R:0}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>