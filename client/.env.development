# ---------------------------------------------------------------
# Modo sin servidor (solo con "npm run dev")
# true  -> se entra con usuarios de prueba y los datos se guardan en el navegador;
#          no hace falta el servidor Node ni MySQL.
# false -> el frontend usa la API real en http://localhost:3001
# Usuarios de prueba: src/mock/mockApi.js (USUARIOS_DEMO)
# La compilación de producción (npm run build) SIEMPRE usa el servidor real.
# ---------------------------------------------------------------
VITE_SIN_SERVIDOR=true
