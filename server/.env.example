# ---------------------------------------------------------------
# Copia este archivo como .env y ajusta los valores.
# ---------------------------------------------------------------

# Puerto donde escucha la API (y la app ya compilada en producción)
PORT=3001

# Base de datos
#   DB_CLIENT=mssql  -> Microsoft SQL Server (predeterminado; esquema: database/sis_invit_sqlserver.sql)
#   DB_CLIENT=mysql  -> MySQL / MariaDB      (esquema: database/sis_invit_mysql.sql)
DB_CLIENT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=inventario
DB_PASSWORD=
DB_NAME=sis_invit

# Solo SQL Server:
# Instancia con nombre (ej. SQLEXPRESS). Si la usas, se ignora DB_PORT.
DB_INSTANCE=
# true si el servidor exige conexión cifrada (Azure SQL siempre)
DB_ENCRYPT=false
# false si el certificado del servidor es de una entidad de confianza (por defecto se acepta el autofirmado)
DB_TRUST_CERT=true

# Clave para firmar las sesiones. Pon una cadena larga y aleatoria,
# por ejemplo la salida de:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Duración de la sesión en horas
SESSION_HOURS=10

# Carpeta donde viven los archivos subidos. Dentro de ella deben quedar
# uploads/ y vistas/img/usuarios/ (las mismas rutas relativas que guarda la BD).
# Si la dejas vacía se usa server/storage
STORAGE_DIR=

# Zona horaria para registrar el último login (el PHP usaba America/Bogota)
TZ=America/Mexico_City

# Comunidad SNMP para leer el tóner de las impresoras
SNMP_COMMUNITY=public

# Pon "true" solo si sirves la app por HTTPS (marca la cookie como Secure)
COOKIE_SECURE=false
